<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <decisions>
        <description>Check if the scheduled ePayment state is &apos;succeeded&apos; or has errors</description>
        <name>Succeeded_Or_Errors</name>
        <label>Succeeded Or Errors</label>
        <locationX>314</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Succeeded</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.OrderApi__Succeeded__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.OrderApi__Succeeded__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Successful_Scheduled_Payment_Email</targetReference>
            </connector>
            <label>Succeeded</label>
        </rules>
        <rules>
            <name>HasErrors</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.OrderApi__Has_Errors__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.OrderApi__Has_Errors__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Failed_Scheduled_Payment_Email</targetReference>
            </connector>
            <label>Has Errors</label>
        </rules>
    </decisions>
    <description>Triggered on scheduled ePayment updates. Checks payment status and sends an email via Fonteva Compliance Send AutoPayment Confirmation Email flow</description>
    <environments>Default</environments>
    <interviewLabel>Font {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Fonteva Compliance ePayment Record Triggered Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>188</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Succeeded_Or_Errors</targetReference>
        </connector>
        <filterLogic>(1 AND 2 AND 3) OR (1 AND 4 AND 5)</filterLogic>
        <filters>
            <field>OrderApi__Scheduled_Payment__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </filters>
        <filters>
            <field>OrderApi__Succeeded__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>OrderApi__Succeeded__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>OrderApi__Has_Errors__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>OrderApi__Has_Errors__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>OrderApi__EPayment__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <subflows>
        <name>Send_Failed_Scheduled_Payment_Email</name>
        <label>Send Failed Scheduled Payment Email</label>
        <locationX>314</locationX>
        <locationY>431</locationY>
        <flowName>Send_AutoPayment_Confirmation_Email</flowName>
        <inputAssignments>
            <name>EmailName</name>
            <value>
                <stringValue>Failed_Scheduled_Payment_Email</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>RecipientId</name>
            <value>
                <elementReference>$Record.OrderApi__Contact__r.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>RecordId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </subflows>
    <subflows>
        <name>Send_Successful_Scheduled_Payment_Email</name>
        <label>Send Successful Scheduled Payment Email</label>
        <locationX>50</locationX>
        <locationY>431</locationY>
        <flowName>Send_AutoPayment_Confirmation_Email</flowName>
        <inputAssignments>
            <name>EmailName</name>
            <value>
                <stringValue>Successful_Scheduled_Payment_Email</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>RecipientId</name>
            <value>
                <elementReference>$Record.OrderApi__Contact__r.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>RecordId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </subflows>
</Flow>
