    <description>This would be used for all before operations on Quote object</description>
    <environments>Default</environments>
    <formulas>
        <name>Current_FY</name>
        <dataType>String</dataType>
        <expression>IF(MONTH(TODAY()) &gt; 3,
RIGHT(TEXT(YEAR(TODAY())),2) &amp; &quot;-&quot; &amp; RIGHT(TEXT(YEAR(TODAY())+1),2),
RIGHT(TEXT(YEAR(TODAY())-1),2) &amp; &quot;-&quot; &amp; RIGHT(TEXT(YEAR(TODAY())),2)
)</expression>
    </formulas>
    <formulas>
        <name>Is_New</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>Quote_Number_Formula</name>
        <dataType>String</dataType>
        <expression>&quot;#ESTd/&quot; &amp; {!Current_FY} &amp; &quot;/&quot; &amp; RIGHT(&quot;000000&quot; &amp; {!$Record.QuoteNumber}, 6)</expression>
    </formulas>
    <formulas>
        <name>quoteName</name>
        <dataType>String</dataType>
        <expression>&apos;# EST/&apos; &amp; {!$Record.Financial_Year__c}&amp; &apos;/&apos; &amp; RIGHT(&quot;000000&quot; &amp; {!$Record.QuoteNumber}, 6)</expression>
    </formulas>
