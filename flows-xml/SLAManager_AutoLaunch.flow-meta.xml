        <inputAssignments>
            <field>SLA_Due_Date__c</field>
            <value>
                <elementReference>SLA_Date_Null_Value</elementReference>
            </value>
        </inputAssignments>
        <object>Lead</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Lead_Record1</name>
        <label>Update Lead Record1</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>SLA_Due_Date__c</field>
