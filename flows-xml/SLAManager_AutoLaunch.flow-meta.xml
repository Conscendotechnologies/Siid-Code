<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Is_Found_Config</name>
        <label>Is Found Config</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Config_Found_and_SLA_Hour_NOT_null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Task_Stage_Config</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Task_Stage_Config.SLA_Hour__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Lead_Record1</targetReference>
            </connector>
            <label>Config Found and SLA Hour NOT null</label>
        </rules>
        <rules>
            <name>Config_Found_and_SLA_Hour_null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Task_Stage_Config.SLA_Hour__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Lead_Record</targetReference>
            </connector>
            <label>Config Found and SLA Hour  null</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>newDateAndTime</name>
        <dataType>Date</dataType>
        <expression>NOW()+({!Get_Task_Stage_Config.SLA_Hour__c} / 24)</expression>
    </formulas>
    <formulas>
        <name>SLA_Date_Null_Value</name>
        <dataType>Date</dataType>
        <expression>NULL</expression>
    </formulas>
    <interviewLabel>SLAManager_AutoLaunch {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SLAManager AutoLaunch</label>
    <processMetadataValues>
