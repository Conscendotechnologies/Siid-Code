<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <customProperties>
        <name>ScreenProgressIndicator</name>
        <value>
            <stringValue>{&quot;location&quot;:&quot;top&quot;,&quot;type&quot;:&quot;simple&quot;}</stringValue>
        </value>
    </customProperties>
    <decisions>
        <name>checkBudget</name>
        <label>Check Budget</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Cold_Result</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Cold_Label</defaultConnectorLabel>
        <rules>
            <name>Hot_Label</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>budget1</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>100000.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Hot_Result</targetReference>
            </connector>
            <label>Hot_Label</label>
        </rules>
        <rules>
            <name>Warm_Lead</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>budget1</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>500000.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Warm_Result</targetReference>
            </connector>
            <label>Warm_Lead</label>
        </rules>
    </decisions>
    <environments>Default</environments>
