<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <assignments>
        <description>Calculates the average review score by dividing the TotalScore by RecordCount. The result is stored in the AverageReviewScore variable to be used for updating the Item record.</description>
        <name>Increment_Total_Score</name>
        <label>Increment Total Score</label>
        <locationX>264</locationX>
        <locationY>647</locationY>
        <assignmentItems>
            <assignToReference>TotalScore</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>ConversionFormula</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>review_Score</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Number_of_Records</name>
        <label>Number of Records</label>
        <locationX>176</locationX>
        <locationY>431</locationY>
        <assignmentItems>
            <assignToReference>RecordCount</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_Related_Reviews</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>review_Score</targetReference>
        </connector>
    </assignments>
    <environments>Default</environments>
    <formulas>
        <name>AverageReviewScore</name>
        <dataType>Number</dataType>
        <expression>{!TotalScore} /{!RecordCount}</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>ConversionFormula</name>
        <dataType>Number</dataType>
        <expression>CASE({!review_Score.OrderApi__Rating__c},
&quot;5&quot;, 5,
&quot;4&quot;, 4,
&quot;3&quot;, 3,
&quot;2&quot;, 2,
&quot;1&quot;, 1,0)</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>calculate Average Score {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Average Review Score CreateUpdate</label>
    <loops>
        <description>Iterates through the collection of related Review records fetched by the &quot;Get Related Reviews&quot; step. Each record&apos;s Rating  is used to increment the total score and the count of reviews</description>
        <name>review_Score</name>
        <label>review Score</label>
        <locationX>176</locationX>
        <locationY>539</locationY>
        <collectionReference>Get_Related_Reviews</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Increment_Total_Score</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_item_Record</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Fetches all Review records related to the same item record  as the triggering record. These records will be used to calculate the total score and count of reviews</description>
        <name>Get_Related_Reviews</name>
        <label>Get Related Reviews</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Number_of_Records</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OrderApi__Item__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.OrderApi__Item__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>OrderApi__Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Published</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>OrderApi__Review__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Updates the Item record with the calculated average review score.</description>
        <name>Update_item_Record</name>
        <label>Update item Record</label>
        <locationX>176</locationX>
        <locationY>839</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.OrderApi__Item__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>OrderApi__Average_Review_Score__c</field>
            <value>
                <elementReference>AverageReviewScore</elementReference>
            </value>
        </inputAssignments>
        <object>OrderApi__Item__c</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Related_Reviews</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OrderApi__Rating__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </filters>
        <object>OrderApi__Review__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>RecordCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>TotalScore</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
</Flow>
