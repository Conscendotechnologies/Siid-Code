    </formulas>
    <formulas>
        <name>SO_Name_Formula</name>
        <dataType>String</dataType>
        <expression>&quot;OC/&quot; &amp; {!Current_FY_Formula} &amp; &quot;/&quot; &amp; {!$Record.OrderNumber}</expression>
    </formulas>
