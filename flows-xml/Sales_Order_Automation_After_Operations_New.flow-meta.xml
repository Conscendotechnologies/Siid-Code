    <formulas>
        <name>calculatesubtotal</name>
        <dataType>Currency</dataType>
        <expression>{!OrderLineItemRecord.ListPrice}*{!OrderLineItemRecord.Quantity}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>Current_FY_Formula</name>
        <dataType>String</dataType>
        <expression>IF(MONTH(TODAY()) &gt; 3,
RIGHT(TEXT(YEAR(TODAY())),2) &amp; &quot;-&quot; &amp; RIGHT(TEXT(YEAR(TODAY())+1),2),
RIGHT(TEXT(YEAR(TODAY())-1),2) &amp; &quot;-&quot; &amp; RIGHT(TEXT(YEAR(TODAY())),2)
)</expression>
    </formulas>
    <formulas>
