            </conditions>
            <connector>
                <targetReference>Set_High_Priority_Lead_Values</targetReference>
            </connector>
            <label>High Priority</label>
        </rules>
        <rules>
            <name>Medium_Priority</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>risklevel</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Medium</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>amount</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
