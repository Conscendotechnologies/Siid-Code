<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>assign_Update_Status_To_Inactive</name>
        <label>Update Status to Inactive</label>
        <locationX>450</locationX>
        <locationY>300</locationY>
        <assignmentItems>
            <assignToReference>Loop_Through_Active_Records.Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Inactive</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Get_Active_Patient_Management_Records_to_update</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Through_Active_Records</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Through_Active_Records</targetReference>
        </connector>
    </assignments>
    <description>Runs daily at 2 AM to update Patient Management records.</description>
    <environments>Default</environments>
    <interviewLabel>DailyInactivePatientManagementUpdate {!$Flow.CurrentDateTime}</interviewLabel>
    <label>DailyInactivePatientManagementUpdate</label>
    <loops>
        <name>Loop_Through_Active_Records</name>
        <label>Loop Through Active Records</label>
        <locationX>350</locationX>
        <locationY>250</locationY>
        <collectionReference>Get_Active_Patient_Management_Records</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>assign_Update_Status_To_Inactive</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Status_To_Inactive</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Active_Patient_Management_Records</name>
        <label>Get Active Patient Management Records</label>
        <locationX>250</locationX>
        <locationY>150</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Through_Active_Records</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </filters>
        <filters>
            <field>LastModifiedDate</field>
            <operator>LessThan</operator>
            <value>
                <dateValue>2023-10-01</dateValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Patient_Management__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Status_To_Inactive</name>
        <label>Update Status to Inactive</label>
        <locationX>450</locationX>
        <locationY>300</locationY>
        <inputReference>Get_Active_Patient_Management_Records_to_update</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Active_Patient_Management_Records</targetReference>
        </connector>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2026-01-01</startDate>
            <startTime>02:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>Get_Active_Patient_Management_Records_to_update</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Patient_Management__c</objectType>
    </variables>
</Flow>
