            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Through_Contacts</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_LastName</name>
        <label>Set LastName</label>
        <locationX>450</locationX>
        <locationY>300</locationY>
        <assignmentItems>
            <assignToReference>currentContact.LastName</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue> Missing</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_To_Contacts_To_Save</targetReference>
        </connector>
    </assignments>
    <description>Scheduled flow to update Contacts without Email.</description>
    <environments>Default</environments>
