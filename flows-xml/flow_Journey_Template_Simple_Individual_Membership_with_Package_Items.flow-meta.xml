    <decisions>
        <description>Determines if the Account Selection Step should be performed or not</description>
        <name>Has_Assigned_Guest_Account_Decision</name>
        <label>Has Assigned Guest Account?</label>
        <locationX>182</locationX>
        <locationY>650</locationY>
        <defaultConnector>
            <targetReference>Marketing_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Has_Assigned_Guest_Account_Outcome</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>UserContact.Account.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Youth Organization Development Association</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Guest_User_s_Contact_Record.Account.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Youth Organization Development Association</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Account_Selection_Step</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Logged_In_Decision</name>
        <label>Is Logged In?</label>
        <locationX>380</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Authentication_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Is_Logged_In_Outcome</name>
            <conditionLogic>(1 AND 2) OR 3</conditionLogic>
            <conditions>
                <leftValueReference>$User.UserType</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Guest</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$User.ContactId</leftValueReference>
                <operator>NotEqualTo</operator>
            </conditions>
            <conditions>
                <leftValueReference>continueAsGuest</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_and_Query_correct_Contact</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
