    <decisions>
        <name>Discount_Exceeded_Logic</name>
        <label>Discount Exceeded Logic</label>
        <locationX>600</locationX>
        <locationY>1595</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Discount_Exceeded_True</name>
            <conditionLogic>(1 OR 2) AND (3 OR 4 OR 5) AND 6</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Discount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>Get_Related_Product.Maximum_Discount_Allowed__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>DiscountValue</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>Get_Related_Product.Maximum_Discount_Allowed__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Is_New</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Discount</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.UnitPrice</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Related_Product.Maximum_Discount_Allowed__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Discount_Exceeded_True</targetReference>
            </connector>
            <label>Discount Exceeded True</label>
        </rules>
        <rules>
            <name>Discount_Exceeded_False</name>
            <conditionLogic>(1 OR 2) AND (3 OR 4 OR 5) AND 6</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Discount</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>Get_Related_Product.Maximum_Discount_Allowed__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>DiscountValue</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>Get_Related_Product.Maximum_Discount_Allowed__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Is_New</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Discount</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.UnitPrice</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Related_Product.Maximum_Discount_Allowed__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Discount_Exceeded_False</targetReference>
            </connector>
            <label>Discount Exceeded False</label>
        </rules>
    </decisions>
