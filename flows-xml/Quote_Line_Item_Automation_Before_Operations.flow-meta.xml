    <description>This would be used for all before operations on QLI object.</description>
    <environments>Default</environments>
    <formulas>
        <name>CalculatedDiscount</name>
        <dataType>Number</dataType>
        <expression>(({!$Record.PricebookEntry.UnitPrice}-{!$Record.UnitPrice})/{!$Record.PricebookEntry.UnitPrice})*100</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>DiscountValue</name>
        <dataType>Number</dataType>
        <expression>(({!$Record.PricebookEntry.UnitPrice}-{!$Record.UnitPrice})/{!$Record.PricebookEntry.UnitPrice})*100</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>Is_New</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>New_GST_Amount</name>
        <dataType>Currency</dataType>
        <expression>If({!$Record.Discount} &gt; 0,
({!$Record.GST__c}/100) * (({!$Record.UnitPrice}*{!$Record.Quantity}) - (({!$Record.Discount}/100)*({!$Record.UnitPrice}*{!$Record.Quantity}))),
({!$Record.GST__c}/100) * ({!$Record.UnitPrice}*{!$Record.Quantity})
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>ResolvedCustomDiscount</name>
        <dataType>Number</dataType>
        <expression>IF(
    NOT(ISBLANK({!$Record.Discount})),
    {!$Record.Discount},
    {!CalculatedDiscount}
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>Updated_GST_Amount</name>
        <dataType>Currency</dataType>
        <expression>If({!$Record.Discount} &gt; 0,
({!$Record.GST__c}/100) * (({!$Record.UnitPrice}*{!$Record.Quantity}) - (({!$Record.Discount}/100)*({!$Record.UnitPrice}*{!$Record.Quantity}))),
({!$Record.GST__c}/100) * ({!$Record.UnitPrice}*{!$Record.Quantity})
)</expression>
        <scale>2</scale>
    </formulas>
