    <environments>Default</environments>
    <formulas>
        <name>ExtractRevisionNumber</name>
        <dataType>Number</dataType>
        <expression>IF(
ISBLANK({!Loop_through_Quotes.Revision_Number__c}),
0,
IF(
LEFT({!Loop_through_Quotes.Revision_Number__c},2) = &quot;V1&quot;,
1,
VALUE(
RIGHT(
{!Loop_through_Quotes.Revision_Number__c},
LEN({!Loop_through_Quotes.Revision_Number__c}) - 5
)
)
)
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>OfferValidity</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate}+90</expression>
    </formulas>
    <formulas>
        <name>RevisionNoMultiple</name>
        <dataType>String</dataType>
        <expression>&quot;REV_V&quot; &amp; TEXT({!varMaxRevision} + 1)</expression>
    </formulas>
