<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_If_Discount_Or_SalesPrice_Is_Present</name>
        <label>Check If Discount Or SalesPrice Is Present?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Discount_Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Discount</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_QLI_Discount</targetReference>
            </connector>
            <label>Is Discount Present?</label>
        </rules>
        <rules>
            <name>Is_SalesPrice_changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.UnitPrice</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_QLI_SalesPrice_DIscount</targetReference>
            </connector>
            <label>Is SalesPrice changed?</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>SalesPriceDiscount</name>
        <dataType>Number</dataType>
        <expression>(({!$Record.PricebookEntry.UnitPrice}-{!$Record.UnitPrice})/{!$Record.PricebookEntry.UnitPrice})*100</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Set Custom Discount Value {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Set Custom Discount Value</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_QLI_Discount</name>
        <label>Update QLI Discount</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Custom_Discount_Value2__c</field>
            <value>
                <elementReference>$Record.Discount</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_QLI_SalesPrice_DIscount</name>
        <label>Update QLI SalesPrice DIscount</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Custom_Discount_Value2__c</field>
            <value>
                <elementReference>SalesPriceDiscount</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_If_Discount_Or_SalesPrice_Is_Present</targetReference>
        </connector>
        <object>QuoteLineItem</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
