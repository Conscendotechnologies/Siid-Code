    <recordUpdates>
        <name>Update_Cold_Lead_Rating</name>
        <label>Update Lead Rating to Cold</label>
        <locationX>250</locationX>
        <locationY>700</locationY>
        <connector>
            <targetReference>Create_Task_Cold</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Rating</field>
            <value>
                <stringValue>Cold</stringValue>
            </value>
        </inputAssignments>
        <object>Lead</object>
    </recordUpdates>
