    <description>Create Relationship records from provided inputs.</description>
    <formulas>
        <name>forT_CalculateFirstText</name>
        <dataType>String</dataType>
        <expression>trim(LEFT({!varT_RemainingText}, FIND({!separator}, {!varT_RemainingText})-1))</expression>
    </formulas>
    <formulas>
        <name>forT_ReCalculateText</name>
        <dataType>String</dataType>
        <expression>Trim(right({!varT_RemainingText}, (len({!varT_RemainingText})-FIND({!separator}, {!varT_RemainingText}))-2))</expression>
    </formulas>
