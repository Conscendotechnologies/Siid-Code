<?xml version='1.0' encoding='utf-8'?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_Amount_Negative</name>
        <label>Check Amount Negative</label>
        <locationX>200</locationX>
        <locationY>100</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Outcome_1_of_Check_Amount_Negative</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Amount</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Err_Amount_Negative</targetReference>
            </connector>
            <label>Amount Is Negative</label>
        </rules>
    </decisions>
    <customErrors>
        <name>Err_Amount_Negative</name>
        <label>Amount Cannot Be Negative</label>
        <locationX>350</locationX>
        <locationY>200</locationY>
        <customErrorMessages>
            <errorMessage>Opportunity Amount cannot be negative</errorMessage>
            <isFieldError>true</isFieldError>
            <fieldSelection>Amount</fieldSelection>
        </customErrorMessages>
    </customErrors>
    <description>Prevents saving an Opportunity when Amount is negative.</description>
    <environments>Default</environments>
    <interviewLabel>Opportunity_Negative_Amount_Error {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity_Negative_Amount_Error</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Amount_Negative</targetReference>
        </connector>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Draft</status>
</Flow>